<?xml version="1.0" encoding="utf-8"?>
<!--
  Android-Huelle der MLapp.

  Sie tut bewusst wenig: Sie liefert die gebaute Web-Fassung aus (dist/) ueber einen lokalen
  Server auf 127.0.0.1 aus und stellt die Sprachausgabe als Dienst bereit. Alles Fachliche
  steckt in der Web-Fassung - es gibt keine zweite Android-Fassung der Inhalte.

  Zielarchitektur-Entscheidung: docs/adr/0001-zielarchitektur.md
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.mlapp.huelle"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="MLapp"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TtsDienst"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
